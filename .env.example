# Copy to .env and fill in:  cp .env.example .env
# .env is git-ignored. Never commit real keys.
#
# Used by:
#   scripts/setup_supabase.py                    (loads .env automatically)
#   uvicorn app.main:app --env-file .env          (the API)
# Keys: Supabase Dashboard -> Project Settings -> API Keys.

# --- Supabase project ------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co

# Key used by the API server. The anon / publishable key is enough: RLS lets
# it read the feed, insert reports and call verify_citizen_report().
SUPABASE_KEY=<anon-key>

# Key for the offline setup/upload script only (creates the bucket, uploads
# PNGs). Use the service_role / secret key. It bypasses RLS: keep it out of the
# frontend. If left empty, the script uses SUPABASE_KEY, which must then be
# the service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# Public Storage bucket for the Golden Path PNGs.
SUPABASE_BUCKET=spherex-golden-path

# Optional: direct Postgres connection string. With it (and
# `pip install "psycopg[binary]"`), setup_supabase.py applies the SQL migration
# itself. Without it, paste the migration into the SQL Editor once.
# Dashboard -> Connect -> Session pooler, e.g.
# SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# --- API (optional) --------------------------------------------------------
# CORS_ORIGINS=*
# REPORTS_DEMO_SEED=1           # in-memory feed only: start with 2 labelled demo examples
# SUPABASE_TIMEOUT_S=5

# --- Image URLs ------------------------------------------------------------
# Server origin used to build absolute image URLs. Unset: each request's own
# base URL (fine locally and behind Render's proxy with --proxy-headers).
# PUBLIC_BASE=https://spherex-api.onrender.com

# --- Live (out-of-cache) jobs (optional) ---------------------------------------
# Needs `pip install -r requirements-science.txt` in the API's venv.
# LIVE_MAX_PER_DETECTOR=1        # cutouts per detector and visit (minimum = fastest)
# LIVE_DOWNLOAD_WORKERS=4        # parallel IRSA cutout downloads (4-6; IRSA answers 503 above)
# LIVE_MAX_FOV_ARCMIN=15         # live jobs are capped at this fov
# LIVE_MAX_RUNNING_JOBS=1
# LIVE_MAX_ACTIVE_JOBS=8
# LIVE_WARMUP=1                  # import the science stack at startup (0 saves ~100 MB until first job)
# JOB_TTL_S=3600
# JOB_RETRY_AFTER_MS=1500        # polling interval suggested to clients
# SIA_BUDGET_S=5                 # offline-first: IRSA gets 5 s, then cached data is served

# --- AI chat (optional; without keys the chat answers with canned texts) -------
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
# CHAT_PROVIDER_TIMEOUT_S=8
# CHAT_RATE_PER_MIN=8            # per IP
# CHAT_DAILY_PROVIDER_CAP=1000   # provider calls per UTC day, all users
# CHAT_CACHE_TTL_S=3600

# --- Game "Encuentra lo que se mueve" (optional) --------------------------------
# GAME_SESSION_TTL_S=900
# GAME_CROP_PX=300
# GAME_SALT=                     # fixed salt for crop file names (random per process if unset)

# --- SIMBAD objects on the image: GET /api/v1/catalog-objects (optional) --------
# SIMBAD_TAP_URL=https://simbad.cds.unistra.fr/simbad/sim-tap/sync
#                                # if CDS is down: https://simbad.cfa.harvard.edu/simbad/sim-tap/sync
# SIMBAD_TIMEOUT_S=5             # offline-first: SIMBAD gets 5 s, then cache / precomputed data is served
# SIMBAD_RATE_PER_MIN=20         # per IP
# SIMBAD_BURST=10                # all users together: up to 10 queries to SIMBAD at once...
# SIMBAD_RATE_PER_S=3            # ...then 3 per second on average (token bucket). SIMBAD's own limit is
#                                # not checked (its docs were unreachable); old name: SIMBAD_GLOBAL_QPS
# SIMBAD_CACHE_TTL_S=3600
# SIMBAD_CACHE_MAX_ENTRIES=500
# SIMBAD_FETCH_LIMIT=200         # rows requested per query
